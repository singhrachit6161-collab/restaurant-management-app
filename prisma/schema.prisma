generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  MANAGER
  CASHIER
  WAITER
  CHEF
  INVENTORY_MANAGER
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  CLEANING
  DISABLED
}

enum SpicyLevel {
  NONE
  MILD
  MEDIUM
  HOT
}

enum OrderType {
  DINE_IN
  TAKEAWAY
  ONLINE
}

enum OrderStatus {
  PENDING
  ACCEPTED
  PREPARING
  READY
  SERVED
  COMPLETED
  CANCELLED
}

enum OrderItemStatus {
  PENDING
  PREPARING
  READY
  SERVED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

enum PaymentMethod {
  CASH
  CARD
  UPI
  WALLET
}

enum IngredientUnit {
  G
  KG
  ML
  L
  PCS
}

enum StockMovementType {
  PURCHASE
  CONSUMPTION
  WASTE
  ADJUSTMENT
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum SupplierInvoiceStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
}

enum SupplierPaymentMethod {
  CASH
  BANK_TRANSFER
  UPI
  CHEQUE
}

enum MembershipTier {
  NONE
  SILVER
  GOLD
  PLATINUM
}

enum LoyaltyTransactionType {
  EARNED
  REDEEMED
  ADJUSTMENT
  REFERRAL_BONUS
}

enum CouponType {
  PERCENT
  FLAT
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  SEATED
  COMPLETED
  CANCELLED
  NO_SHOW
}

model Account {
  id                     String   @id @default(cuid())
  name                   String
  loyaltyPointsPerAmount Float    @default(1)
  loyaltyRedemptionValue Float    @default(0.5)
  referralBonusPoints    Int      @default(50)
  createdAt              DateTime @default(now())

  restaurants Restaurant[]
  users       User[]
  customers   Customer[]
}

model Restaurant {
  id                   String   @id @default(cuid())
  accountId            String
  account              Account  @relation(fields: [accountId], references: [id])
  name                 String
  address              String?
  gstNumber            String?
  currency             String   @default("INR")
  taxRatePercent       Float    @default(5)
  serviceChargePercent Float    @default(0)
  logoUrl              String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  users               User[]
  tables              Table[]
  categories          MenuCategory[]
  items               MenuItem[]
  orders              Order[]
  invoices            Invoice[]
  ingredients         Ingredient[]
  suppliers           Supplier[]
  purchaseOrders      PurchaseOrder[]
  supplierInvoices    SupplierInvoice[]
  supplierPayments    SupplierPayment[]
  loyaltyTransactions LoyaltyTransaction[]
  coupons             Coupon[]
  couponRedemptions   CouponRedemption[]
  reservations        Reservation[]

  @@index([accountId])
}

model User {
  id           String     @id @default(cuid())
  accountId    String
  account      Account    @relation(fields: [accountId], references: [id])
  name         String
  email        String     @unique
  passwordHash String
  role         Role
  active       Boolean    @default(true)
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  createdAt    DateTime   @default(now())

  ordersCreated    Order[]           @relation("OrderCreatedBy")
  stockMovements   StockMovement[]
  purchaseOrders   PurchaseOrder[]
  supplierPayments SupplierPayment[]
  reservations     Reservation[]

  @@index([accountId])
}

model Table {
  id           String      @id @default(cuid())
  restaurantId String
  restaurant   Restaurant  @relation(fields: [restaurantId], references: [id])
  name         String
  code         String      @unique
  capacity     Int         @default(2)
  status       TableStatus @default(AVAILABLE)
  createdAt    DateTime    @default(now())

  orders       Order[]
  reservations Reservation[]

  @@index([restaurantId])
}

model MenuCategory {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  name         String
  sortOrder    Int        @default(0)
  active       Boolean    @default(true)

  items MenuItem[]

  @@index([restaurantId])
}

model MenuItem {
  id              String       @id @default(cuid())
  restaurantId    String
  restaurant      Restaurant   @relation(fields: [restaurantId], references: [id])
  categoryId      String
  category        MenuCategory @relation(fields: [categoryId], references: [id])
  name            String
  description     String?
  price           Float
  imageUrl        String?
  isVeg           Boolean      @default(true)
  spicyLevel      SpicyLevel   @default(NONE)
  prepTimeMinutes Int          @default(10)
  calories        Int?
  isBestseller    Boolean      @default(false)
  isAvailable     Boolean      @default(true)
  sortOrder       Int          @default(0)
  createdAt       DateTime     @default(now())

  orderItems OrderItem[]
  recipe     RecipeIngredient[]

  @@index([restaurantId])
  @@index([categoryId])
}

model Ingredient {
  id                String         @id @default(cuid())
  restaurantId      String
  restaurant        Restaurant     @relation(fields: [restaurantId], references: [id])
  name              String
  unit              IngredientUnit
  costPerUnit       Float
  currentStock      Float          @default(0)
  lowStockThreshold Float          @default(0)
  expiryDate        DateTime?
  supplierId        String?
  supplier          Supplier?      @relation(fields: [supplierId], references: [id])
  createdAt         DateTime       @default(now())

  recipeUses         RecipeIngredient[]
  movements          StockMovement[]
  purchaseOrderItems PurchaseOrderItem[]

  @@index([restaurantId])
  @@index([supplierId])
}

model RecipeIngredient {
  id           String     @id @default(cuid())
  menuItemId   String
  menuItem     MenuItem   @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])
  quantity     Float

  @@unique([menuItemId, ingredientId])
  @@index([menuItemId])
  @@index([ingredientId])
}

model StockMovement {
  id              String            @id @default(cuid())
  ingredientId    String
  ingredient      Ingredient        @relation(fields: [ingredientId], references: [id])
  type            StockMovementType
  quantity        Float
  note            String?
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder?    @relation(fields: [purchaseOrderId], references: [id])
  createdById     String?
  createdBy       User?             @relation(fields: [createdById], references: [id])
  createdAt       DateTime          @default(now())

  @@index([ingredientId])
  @@index([purchaseOrderId])
}

model Order {
  id             String         @id @default(cuid())
  restaurantId   String
  restaurant     Restaurant     @relation(fields: [restaurantId], references: [id])
  orderNumber    Int
  tableId        String?
  table          Table?         @relation(fields: [tableId], references: [id])
  type           OrderType      @default(DINE_IN)
  status         OrderStatus    @default(PENDING)
  customerName   String?
  customerId     String?
  customer       Customer?      @relation(fields: [customerId], references: [id])
  couponId       String?
  coupon         Coupon?        @relation(fields: [couponId], references: [id])
  pointsRedeemed Int            @default(0)
  notes          String?
  subtotal       Float          @default(0)
  taxAmount      Float          @default(0)
  serviceCharge  Float          @default(0)
  discount       Float          @default(0)
  total          Float          @default(0)
  paymentStatus  PaymentStatus  @default(UNPAID)
  paymentMethod  PaymentMethod?
  createdById    String?
  createdBy      User?          @relation("OrderCreatedBy", fields: [createdById], references: [id])
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  items               OrderItem[]
  invoice             Invoice?
  loyaltyTransactions LoyaltyTransaction[]
  couponRedemption    CouponRedemption?

  @@index([restaurantId])
  @@index([tableId])
  @@index([status])
  @@index([customerId])
  @@index([couponId])
}

model OrderItem {
  id            String          @id @default(cuid())
  orderId       String
  order         Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId    String
  menuItem      MenuItem        @relation(fields: [menuItemId], references: [id])
  name          String
  price         Float
  quantity      Int             @default(1)
  notes         String?
  status        OrderItemStatus @default(PENDING)
  stockDeducted Boolean         @default(false)

  @@index([orderId])
}

model Invoice {
  id            String         @id @default(cuid())
  invoiceNumber Int
  restaurantId  String
  restaurant    Restaurant     @relation(fields: [restaurantId], references: [id])
  orderId       String         @unique
  order         Order          @relation(fields: [orderId], references: [id])
  subtotal      Float
  taxAmount     Float
  serviceCharge Float
  discount      Float
  total         Float
  paymentMethod PaymentMethod?
  createdAt     DateTime       @default(now())

  @@index([restaurantId])
}

model Supplier {
  id            String     @id @default(cuid())
  restaurantId  String
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id])
  name          String
  contactPerson String?
  phone         String?
  email         String?
  address       String?
  gstNumber     String?
  createdAt     DateTime   @default(now())

  ingredients    Ingredient[]
  purchaseOrders PurchaseOrder[]
  invoices       SupplierInvoice[]
  payments       SupplierPayment[]

  @@index([restaurantId])
}

model PurchaseOrder {
  id           String              @id @default(cuid())
  restaurantId String
  restaurant   Restaurant          @relation(fields: [restaurantId], references: [id])
  poNumber     Int
  supplierId   String
  supplier     Supplier            @relation(fields: [supplierId], references: [id])
  status       PurchaseOrderStatus @default(DRAFT)
  orderDate    DateTime            @default(now())
  expectedDate DateTime?
  notes        String?
  createdById  String?
  createdBy    User?               @relation(fields: [createdById], references: [id])
  createdAt    DateTime            @default(now())

  items          PurchaseOrderItem[]
  stockMovements StockMovement[]
  invoices       SupplierInvoice[]

  @@index([restaurantId])
  @@index([supplierId])
  @@index([status])
}

model PurchaseOrderItem {
  id               String        @id @default(cuid())
  purchaseOrderId  String
  purchaseOrder    PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  ingredientId     String
  ingredient       Ingredient    @relation(fields: [ingredientId], references: [id])
  quantityOrdered  Float
  unitCost         Float
  quantityReceived Float         @default(0)

  @@index([purchaseOrderId])
  @@index([ingredientId])
}

model SupplierInvoice {
  id              String                @id @default(cuid())
  restaurantId    String
  restaurant      Restaurant            @relation(fields: [restaurantId], references: [id])
  invoiceNumber   String
  supplierId      String
  supplier        Supplier              @relation(fields: [supplierId], references: [id])
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder?        @relation(fields: [purchaseOrderId], references: [id])
  amount          Float
  amountPaid      Float                 @default(0)
  dueDate         DateTime?
  status          SupplierInvoiceStatus @default(UNPAID)
  createdAt       DateTime              @default(now())

  payments SupplierPayment[]

  @@index([restaurantId])
  @@index([supplierId])
}

model SupplierPayment {
  id           String                @id @default(cuid())
  restaurantId String
  restaurant   Restaurant            @relation(fields: [restaurantId], references: [id])
  supplierId   String
  supplier     Supplier              @relation(fields: [supplierId], references: [id])
  invoiceId    String?
  invoice      SupplierInvoice?      @relation(fields: [invoiceId], references: [id])
  amount       Float
  method       SupplierPaymentMethod
  note         String?
  createdById  String?
  createdBy    User?                 @relation(fields: [createdById], references: [id])
  paidAt       DateTime              @default(now())

  @@index([restaurantId])
  @@index([supplierId])
  @@index([invoiceId])
}

model Customer {
  id                   String         @id @default(cuid())
  accountId            String
  account              Account        @relation(fields: [accountId], references: [id])
  name                 String
  phone                String
  email                String?
  birthday             DateTime?
  anniversary          DateTime?
  loyaltyPoints        Float          @default(0)
  lifetimePoints       Float          @default(0)
  membershipTier       MembershipTier @default(NONE)
  referralCode         String         @unique
  referredByCustomerId String?
  referredByCustomer   Customer?      @relation("Referrals", fields: [referredByCustomerId], references: [id])
  createdAt            DateTime       @default(now())

  orders              Order[]
  loyaltyTransactions LoyaltyTransaction[]
  couponRedemptions   CouponRedemption[]
  referrals           Customer[]           @relation("Referrals")
  reservations        Reservation[]

  @@unique([accountId, phone])
  @@index([accountId])
}

model LoyaltyTransaction {
  id           String                 @id @default(cuid())
  customerId   String
  customer     Customer               @relation(fields: [customerId], references: [id])
  restaurantId String
  restaurant   Restaurant             @relation(fields: [restaurantId], references: [id])
  orderId      String?
  order        Order?                 @relation(fields: [orderId], references: [id])
  type         LoyaltyTransactionType
  points       Float
  note         String?
  createdAt    DateTime               @default(now())

  @@index([customerId])
  @@index([restaurantId])
  @@index([orderId])
}

model Coupon {
  id                    String     @id @default(cuid())
  restaurantId          String
  restaurant            Restaurant @relation(fields: [restaurantId], references: [id])
  code                  String
  type                  CouponType
  value                 Float
  minOrderValue         Float?
  maxDiscount           Float?
  usageLimit            Int?
  usageLimitPerCustomer Int?
  validFrom             DateTime?
  validUntil            DateTime?
  active                Boolean    @default(true)
  createdAt             DateTime   @default(now())

  orders      Order[]
  redemptions CouponRedemption[]

  @@unique([restaurantId, code])
  @@index([restaurantId])
}

model CouponRedemption {
  id              String      @id @default(cuid())
  couponId        String
  coupon          Coupon      @relation(fields: [couponId], references: [id])
  orderId         String      @unique
  order           Order       @relation(fields: [orderId], references: [id])
  customerId      String?
  customer        Customer?   @relation(fields: [customerId], references: [id])
  discountApplied Float
  createdAt       DateTime    @default(now())
  restaurant      Restaurant? @relation(fields: [restaurantId], references: [id])
  restaurantId    String?

  @@index([couponId])
  @@index([customerId])
}

model Reservation {
  id              String            @id @default(cuid())
  restaurantId    String
  restaurant      Restaurant        @relation(fields: [restaurantId], references: [id])
  customerId      String?
  customer        Customer?         @relation(fields: [customerId], references: [id])
  customerName    String
  customerPhone   String
  tableId         String?
  table           Table?            @relation(fields: [tableId], references: [id])
  partySize       Int
  reservationDate DateTime
  reservationTime String
  status          ReservationStatus @default(PENDING)
  specialRequest  String?
  createdById     String?
  createdBy       User?             @relation(fields: [createdById], references: [id])
  createdAt       DateTime          @default(now())

  @@index([restaurantId])
  @@index([tableId])
  @@index([customerId])
  @@index([reservationDate])
}
